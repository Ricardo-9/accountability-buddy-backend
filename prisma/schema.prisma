generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//ENUMS

enum AccountabilityArea {
  GYM
  NUTRITION
  FINANCES
  PRODUCTIVITY
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InvestorStyle {
  LOW
  MEDIUM
  HIGH
}

enum DurationUnit {
  WEEKS
  MONTHS
}

enum TaskStatus {
  PENDING
  PARTIAL
  COMPLETED
  SKIPPED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecipeSource {
  AI
  USER
}

//BASE MODELS

model UserProfile {
  id        String    @id @db.Uuid
  fullName  String
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserArea {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  area      AccountabilityArea
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, area])
  @@index([userId])
}

model FitnessProfile {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @db.Uuid
  goal      String?
  heightCm  Int?
  weightKg  Decimal?      @db.Decimal(5, 2)
  injuries  String?
  level     FitnessLevel?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
