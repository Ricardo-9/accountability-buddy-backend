generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//ENUMS

enum AccountabilityArea {
  GYM
  NUTRITION
  FINANCES
  PRODUCTIVITY
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InvestorStyle {
  LOW
  MEDIUM
  HIGH
}

enum DurationUnit {
  WEEKS
  MONTHS
}

enum ReportType {
  WEEKLY
  MONTHLY
}

enum TaskStatus {
  PENDING
  PARTIAL
  COMPLETED
  SKIPPED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecipeSource {
  AI
  USER
}

enum Domain {
  WORK
  HOBBIES
  SLEEP
  LEISURE
}

// BASE MODELS

model UserProfile {
  id        String    @id @db.Uuid
  fullName  String?
  birthDate DateTime? @db.Date
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  //Relations
  userArea              UserArea[]
  fitnessProfile        FitnessProfile?
  nutritionProfile      NutritionProfile?
  diet                  Diet[]
  ingredient            Ingredient[]
  recipe                Recipe[]
  waterLog              WaterLog[]
  financeAccount        FinanceAccount?
  income                Income[]
  financialGoal         FinancialGoal[]
  fixedExpense          FixedExpense[]
  variableExpense       VariableExpense[]
  financeBalanceHistory FinanceBalanceHistory[]
  financialCategory     FinancialCategory[]
  task                  Task[]
  workoutPlan           WorkoutPlan[]
  weightLog             WeightLog[]
  generatedReport       GeneratedReport[]
}

model UserArea {
  id        String             @id @default(uuid()) @db.Uuid
  user      UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String             @db.Uuid
  area      AccountabilityArea
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, area])
  @@index([userId])
}

// FITNESS PROFILE

model FitnessProfile {
  id        String        @id @default(uuid()) @db.Uuid
  user      UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String        @unique @db.Uuid
  goal      String?
  heightCm  Int?
  weightKg  Decimal?      @db.Decimal(5, 2)
  injuries  String?
  level     FitnessLevel?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// NUTRITION MODELS

model NutritionProfile {
  id              String      @id @default(uuid()) @db.Uuid
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String      @unique @db.Uuid
  goal            String?
  heightCm        Int?
  weightKg        Decimal?    @db.Decimal(5, 2)
  preference      String?
  allergies       String?
  waterGoalLiters Decimal?    @db.Decimal(4, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Diet {
  id        String      @id @default(uuid()) @db.Uuid
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  name      String
  structure Json        @db.JsonB
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Ingredient {
  id        String             @id @default(uuid()) @db.Uuid
  user      UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String             @db.Uuid
  name      String
  recipes   RecipeIngredient[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Recipe {
  id           String             @id @default(uuid()) @db.Uuid
  user         UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String             @db.Uuid
  name         String
  preparation  String
  notes        String?
  source       RecipeSource
  editedByUser Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]

  @@index([userId])
}

model RecipeIngredient {
  id            String     @id @default(uuid()) @db.Uuid
  recipe        Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String     @db.Uuid
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId  String     @db.Uuid
  quantityGrams Decimal    @db.Decimal(8, 2)
  createdAt     DateTime   @default(now())

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
}

model WaterLog {
  id       String      @id @default(uuid()) @db.Uuid
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String      @db.Uuid
  amountMl Int
  loggedAt DateTime    @default(now())

  @@index([userId, loggedAt])
}

// FINANCIAL MODELS

model FinanceAccount {
  id        String      @id @default(uuid()) @db.Uuid
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @unique @db.Uuid
  balance   Decimal     @db.Decimal(14, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Income {
  id        String      @id @default(uuid()) @db.Uuid
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  amount    Decimal     @db.Decimal(14, 2)
  source    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model FinancialGoal {
  id            String                 @id @default(uuid()) @db.Uuid
  user          UserProfile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String                 @db.Uuid
  category      FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?                @db.Uuid
  deposit       GoalDeposit[]
  snapshot      GoalProgressSnapshot[]
  name          String
  target        Decimal                @db.Decimal(14, 2)
  durationValue Int
  durationUnit  DurationUnit
  style         InvestorStyle
  initialAmount Decimal                @db.Decimal(14, 2)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
  @@index([categoryId])
}

model FixedExpense {
  id            String             @id @default(uuid()) @db.Uuid
  user          UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String             @db.Uuid
  category      FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?            @db.Uuid
  name          String
  monthlyAmount Decimal            @db.Decimal(14, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([categoryId])
}

model VariableExpense {
  id          String             @id @default(uuid()) @db.Uuid
  user        UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String             @db.Uuid
  category    FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?            @db.Uuid
  name        String
  amount      Decimal            @db.Decimal(14, 2)
  expenseDate DateTime           @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, expenseDate])
  @@index([categoryId])
}

model GoalDeposit {
  id          String        @id @default(uuid()) @db.Uuid
  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String        @db.Uuid
  amount      Decimal       @db.Decimal(14, 2)
  depositDate DateTime      @db.Date
  createdAt   DateTime      @default(now())

  @@index([goalId, depositDate])
}

model GoalProgressSnapshot {
  id             String        @id @default(uuid()) @db.Uuid
  goal           FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId         String        @db.Uuid
  totalDeposited Decimal       @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())

  @@index([goalId, createdAt])
}

model FinanceBalanceHistory {
  id        String      @id @default(uuid()) @db.Uuid
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  balance   Decimal     @db.Decimal(14, 2)
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

model FinancialCategory {
  id               String            @id @default(uuid()) @db.Uuid
  user             UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String            @db.Uuid
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fixedExpenses    FixedExpense[]
  variableExpenses VariableExpense[]
  financialGoals   FinancialGoal[]

  @@unique([userId, name])
  @@index([userId])
}

// PRODUCTIVITY MODEL

model Task {
  id            String      @id @default(uuid()) @db.Uuid
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String      @db.Uuid
  title         String
  domain        Domain
  scheduledDate DateTime    @db.Date
  status        TaskStatus
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, scheduledDate])
}

// FITNESS MODELS

model WorkoutPlan {
  id             String           @id @default(uuid()) @db.Uuid
  user           UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  workoutPlanDay WorkoutPlanDay[]
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
}

model WorkoutPlanDay {
  id              String            @id @default(uuid()) @db.Uuid
  workoutPlan     WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  workoutPlanId   String            @db.Uuid
  workoutExercise WorkoutExercise[]
  workoutTracking WorkoutTracking[]
  weekDay         WeekDay

  @@unique([workoutPlanId, weekDay])
  @@index([workoutPlanId])
}

model WorkoutExercise {
  id               String         @id @default(uuid()) @db.Uuid
  workoutPlanDay   WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  workoutPlanDayId String         @db.Uuid
  name             String
  sets             Int
  repsMin          Int
  repsMax          Int
  restSeconds      Int
  notes            String?

  @@index([workoutPlanDayId])
}

model WorkoutTracking {
  id                      String                    @id @default(uuid()) @db.Uuid
  workoutPlanDay          WorkoutPlanDay            @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  workoutPlanDayId        String                    @db.Uuid
  workoutTrackingExercise WorkoutTrackingExercise[]
  createdAt               DateTime                  @default(now())

  @@index([workoutPlanDayId, createdAt])
}

model WorkoutTrackingExercise {
  id                String          @id @default(uuid()) @db.Uuid
  workoutTracking   WorkoutTracking @relation(fields: [workoutTrackingId], references: [id], onDelete: Cascade)
  workoutTrackingId String          @db.Uuid
  name              String
  maxWeight         Decimal?        @db.Decimal(6, 2)
  maxSets           Int?
  maxReps           Int?
  restSeconds       Int?
  notes             String?

  @@index([workoutTrackingId])
}

model WeightLog {
  id       String      @id @default(uuid()) @db.Uuid
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String      @db.Uuid
  weightKg Decimal     @db.Decimal(5, 2)
  loggedAt DateTime    @default(now())

  @@index([userId, loggedAt])
}

// REPORT

model GeneratedReport {
  id          String             @id @default(uuid()) @db.Uuid
  user        UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String             @db.Uuid
  domain      AccountabilityArea
  type        ReportType
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date
  metricsJson Json               @db.JsonB
  aiSummary   String
  createdAt   DateTime           @default(now())

  @@unique([userId, domain, type, periodStart, periodEnd])
  @@index([userId, domain, type])
  @@index([userId, periodStart])
}
